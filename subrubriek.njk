---
layout: layouts/base.njk
pagination:
  data: inhoud.paginaSubs
  size: 1
  alias: p
  addAllPagesToCollections: true
permalink: "{{ p.url }}"
eleventyComputed:
  lang: "{{ p.lang }}"
  title: "{{ p.naam }}"
  description: "{{ p.kort }}"
---
{% set T = inhoud.talen[lang] %}
{% from "partials/kruimel.njk" import kruimel %}
<div class="wrap pagina">
  {{ kruimel([{ "naam": site.naam, "url": T.pre + "/" }, { "naam": "& " + p.rubriek.naam, "url": p.rubriek.url }, { "naam": p.naam, "url": p.url }], T, site) }}
  <header class="paginakop">
    <h1>{{ p.naam }}</h1>
    <p class="intro">{{ p.intro or p.kort }}</p>
    {% if p.tekst %}<div class="rubriektekst">{{ p.tekst | md | safe }}</div>{% endif %}
  </header>
  {% set lijst = T.items | itemsIn(p.rubriek.key, p.key) %}
  {% include "partials/itemlijst.njk" %}
</div>
