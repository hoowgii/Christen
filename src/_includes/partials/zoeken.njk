{% from "partials/kruimel.njk" import kruimel %}
<div class="wrap pagina">
  {{ kruimel([{ "naam": site.naam, "url": T.pre + "/" }, { "naam": T.t.zoeken, "url": page.url }], T, site) }}
  <header class="paginakop"><h1>{{ T.t.zoeken }}</h1></header>
  <form class="zoekveld" action="{{ T.t.urls.zoeken }}" method="get" role="search" data-zoeken>
    <label class="sr" for="zoek-pagina">{{ T.t.zoekLabel }}</label>
    <input id="zoek-pagina" type="search" name="q" placeholder="{{ T.t.zoekPlaceholder }}" autocomplete="off">
    <button class="knop" type="submit">{{ T.t.zoeken }}</button>
  </form>
  <p class="zoekstatus" data-status aria-live="polite"></p>
  <div class="items" data-resultaten></div>
  <noscript><p class="leeg">{{ T.t.noscript }} <a href="{{ T.t.urls.onderwerpen }}">{{ T.t.onderwerpen | lower }}</a>.</p></noscript>
  <p class="zoekhulp">{{ T.t.zoekHulp }} <a href="{{ T.t.urls.onderwerpen }}">{{ T.t.onderwerpen | lower }}</a>.</p>
</div>
