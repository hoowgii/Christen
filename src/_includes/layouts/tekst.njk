---
layout: layouts/base.njk
---
{%- set T = inhoud.talen[lang] -%}
{% from "partials/kruimel.njk" import kruimel %}
<div class="wrap pagina">
  {{ kruimel([{ "naam": site.naam, "url": T.pre + "/" }, { "naam": title, "url": page.url }], T, site) }}
  <article class="tekst">
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </article>
</div>
