{%- set T = inhoud.talen[lang] -%}
{%- set A = alts or (p.alts if p else {}) -%}
{%- set ander = "en" if lang == "nl" else "nl" -%}
{%- set volleTitel = (title + " | " + site.naam) if title else (site.naam + " – " + T.t.heldTitel) -%}
{%- set beschrijving = description or T.t.beschrijving -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ volleTitel }}</title>
  <meta name="description" content="{{ beschrijving }}">
  {%- if noindex %}
  <meta name="robots" content="noindex, follow">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- for l, u in A %}
  <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ u }}">
  {%- endfor %}
  {%- if A.nl %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ A.nl }}">
  {%- endif %}
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.naam }}">
  <meta property="og:title" content="{{ title or site.naam }}">
  <meta property="og:description" content="{{ beschrijving }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{{ T.t.locale }}">
  <meta property="og:image" content="{{ site.url }}/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#102A43">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="home" href="/" data-basis>
  <link rel="preload" href="/fonts/eb-garamond-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  {%- if zoekpagina %}
  <link rel="preload" href="{{ T.pre }}/zoekindex.json" as="fetch" crossorigin data-zoekindex>
  {%- endif %}
  {%- if page.url == T.pre + "/" %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": site.naam,
    "url": site.url + T.pre + "/",
    "inLanguage": lang,
    "description": T.t.beschrijving,
    "publisher": { "@type": "Organization", "name": site.naam, "url": site.url + "/", "logo": site.url + "/og.png" }
  } | json | safe }}</script>
  {%- endif %}
  <script>document.documentElement.classList.add("js")</script>
  <script src="/js/site.js" defer></script>
</head>
<body>
  <a class="skiplink" href="#inhoud">{{ T.t.naarInhoud }}</a>
  {% include "partials/header.njk" %}
  <main id="inhoud">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
