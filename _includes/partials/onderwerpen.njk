{% from "partials/kruimel.njk" import kruimel %}
<div class="wrap pagina">
  {{ kruimel([{ "naam": site.naam, "url": T.pre + "/" }, { "naam": T.t.onderwerpen, "url": page.url }], T, site) }}
  <header class="paginakop">
    <h1>{{ T.t.onderwerpen }}</h1>
    <p class="intro">{{ T.t.onderwerpenIntro }}</p>
  </header>
  <ul class="onderwerpen">
    {% for o in T.onderwerpen %}
    <li><a href="{{ o.url }}">{{ o.label | hoofdletter }} <span>{{ (T.items | metTag(o.key)).length }}</span></a></li>
    {% endfor %}
  </ul>
</div>
