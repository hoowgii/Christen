<section class="held">
  <div class="wrap">
    <h1 class="held__titel">{{ T.t.heldTitel }}</h1>
    <p class="held__intro">{{ T.t.heldIntro }}</p>
    <form class="zoekveld" action="{{ T.t.urls.zoeken }}" method="get" role="search">
      <label class="sr" for="zoek-home">{{ T.t.zoekLabel }}</label>
      <input id="zoek-home" type="search" name="q" placeholder="{{ T.t.zoekPlaceholderHome }}" autocomplete="off">
      <button class="knop" type="submit">{{ T.t.zoeken }}</button>
    </form>
    <div class="snel">
      <p id="snel-label">{{ T.t.veelGezocht }}</p>
      <ul aria-labelledby="snel-label">
        {% for s in T.t.snel %}<li><a href="{{ s.url }}">{{ s.tekst }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="rubrieken" aria-labelledby="rubrieken-titel">
  <div class="wrap">
    <h2 id="rubrieken-titel" class="rubrieken__titel">Christen <span class="en">&amp;</span><span class="sr"> {{ T.t.rubrieken }}</span></h2>
    {% set tegels = T.rubrieken %}{% set metEn = true %}
    {% include "partials/tegels.njk" %}
  </div>
</section>

<section class="begin" aria-labelledby="begin-titel">
  <div class="wrap begin__binnen">
    <div>
      <h2 id="begin-titel">{{ T.t.beginTitel }}</h2>
      <p>{{ T.t.beginTekst }}</p>
      <a class="knop" href="{{ T.t.beginUrl }}">{{ T.t.beginKnop }}</a>
    </div>
    <ol class="stappen">
      {% for s in T.t.stappen %}<li><a href="{{ s.url }}">{{ s.titel }}</a><span>{{ s.tekst }}</span></li>{% endfor %}
    </ol>
  </div>
</section>
